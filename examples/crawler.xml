<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://org.webharvest/schema/2.1/core" charset="UTF-8">

    <!-- set initial page -->
    <def var="home">http://web-harvest.sourceforge.net/index.php</def>

    <!-- define script functions and variables -->
    <def var="unvisited">
        <list>
            <template>${home}</template>
        </list>
    </def>
    
    <def var="visited">
        <list></list>
    </def>
    
    <def var="newLinks">
        <list></list>
    </def>

    <!-- loop while there are any unvisited links -->
    <while condition="${unvisited.toString().length() > 0}">
        <loop item="currUrl">
            <list>
                <get var="unvisited"/>
            </list>
            <body>
                <empty>
                    <def var="content">
                        <html-to-xml>
                            <http url="${currUrl}"/>
                        </html-to-xml>
                    </def>

                    <def var="currentFullUrl">
                        <template>${sys.fullUrl(home, currUrl)}</template>
                    </def>

                    <!--  saves downloaded page -->
                    <file action="write" path='spider/${currentFullUrl.replaceAll("http://|https://|file://", "")}.html'>
                        <get var="content"/>
                    </file>

                    <!-- adds current URL to the list of visited -->
                    <def var="visitedUpdate">
                        <script><![CDATA[
                            print("Visiting: " + currUrl);
                        ]]></script>
                    </def>
                    
                    <def var="newLinks">
                        <list></list>
                    </def>

                    <!-- loop through all collected links on the downloaded page -->
                    <loop item="currLink">
                        <list>
                            <xpath expression="//a/@href">
                                <get var="content"/>
                            </xpath>
                        </list>
                        <body>
                            <def var="linkCheck">
                                <script><![CDATA[
                                    /* checks if specified URL is valid for download */
                                    boolean isValidUrl(String url) {
                                        String urlSmall = url.toLowerCase();
                                        return urlSmall.startsWith("http://web-harvest.sourceforge.net/") && urlSmall.endsWith(".php");
                                    }
                                    String fullLink = sys.fullUrl(home, currLink);
                                    if ( isValidUrl(fullLink.toString()) ) {
                                        print("Found valid link: " + fullLink);
                                    }
                                ]]></script>
                            </def>
                        </body>
                    </loop>
                </empty>
            </body>
        </loop>

        <!-- unvisited link are now all the collected new links from downloaded pages  -->
        <def var="unvisited">
            <list></list>
        </def>
    </while>

</config>